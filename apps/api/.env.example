ENVIRONMENT=development
DEBUG=true
API_PUBLIC_BASE=http://localhost:8000
STOREFRONT_PUBLIC_BASE=http://localhost:3000
# MongoDB (local/offline — no Atlas required)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=visualshop
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_PATH=/tmp/visual-shop-storage
MEDIA_PUBLIC_BASE=http://localhost:8000/media
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=visual-shop
S3_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
# Default offline embedding stub (no HuggingFace/SigLIP2 download)
EMBEDDING_BACKEND=perceptual
EMBEDDING_MODEL_NAME=google/siglip2-base-patch16-224
# Opt into SigLIP2 only when online: pip install -r requirements-ml.txt
# and set EMBEDDING_BACKEND=siglip2 on api + worker, then re-seed/reindex.
INDEX_SYNC=1
PAYMENT_PROVIDER=stub
STUB_PAYMENT_SECRET=visual-shop-stub-secret
