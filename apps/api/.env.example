ENVIRONMENT=development
DEBUG=true
API_PUBLIC_BASE=http://localhost:8000
STOREFRONT_PUBLIC_BASE=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://visualshop:visualshop@localhost:5432/visualshop
DATABASE_URL_SYNC=postgresql://visualshop:visualshop@localhost:5432/visualshop
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=/tmp/visual-shop-storage
MEDIA_PUBLIC_BASE=http://localhost:8000/media
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=visual-shop
S3_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
EMBEDDING_BACKEND=perceptual
EMBEDDING_MODEL_NAME=google/siglip2-base-patch16-224
# Set INDEX_SYNC=1 to index uploads inline instead of Celery (useful for debugging)
INDEX_SYNC=0
# Payments: stub (default demo) or stripe
PAYMENT_PROVIDER=stub
STUB_PAYMENT_SECRET=visual-shop-stub-secret
